generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  employee
  manager
  finance
  admin
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String?
  name         String
  active       Boolean        @default(true)
  role         Role
  managerId    String?
  manager      User?          @relation("Hierarchy", fields: [managerId], references: [id], onDelete: Restrict)
  reports      User[]         @relation("Hierarchy")
  tokens       OneTimeToken[]
  sessions     Session[]
  claims       Claim[]        @relation("Claimant")
  approvals    Claim[]        @relation("Approver")
  events       ClaimEvent[]
  uploads      Receipt[]

  @@index([managerId])
}

enum TokenPurpose {
  set_password
  reset
}

model OneTimeToken {
  hash      String       @id
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model Session {
  idHash     String   @id
  csrfHash   String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime
  lastSeenAt DateTime

  @@index([userId])
}

model LoginAttempt {
  kind        String
  email       String
  windowStart DateTime
  count       Int
  lockedUntil DateTime?

  @@id([kind, email])
}

enum ClaimStatus {
  draft
  submitted
  approved
  rejected
  ready_to_pay
  paid
}

enum EventAction {
  submit
  resubmit
  withdrawn
  approve_first
  approve_final
  reject
  approve_second
  reject_second
  send_back
  pay
  reassigned
}

model Category {
  code       String      @id
  label      String
  limitCents Int
  lines      ClaimLine[]
}

model Claim {
  id                  String       @id @default(uuid())
  claimantId          String
  claimant            User         @relation("Claimant", fields: [claimantId], references: [id], onDelete: Restrict)
  title               String
  purpose             String
  status              ClaimStatus  @default(draft)
  approverId          String?
  approver            User?        @relation("Approver", fields: [approverId], references: [id], onDelete: Restrict)
  createdAt           DateTime
  updatedAt           DateTime
  submittedAt         DateTime?
  paymentDate         String?
  paymentReference    String?
  secondApprovalCents Int?
  lines               ClaimLine[]
  events              ClaimEvent[]
  receipts            Receipt[]

  @@index([claimantId, updatedAt])
  @@index([approverId, status])
  @@index([status, updatedAt])
}

model ClaimLine {
  id               String    @id @default(uuid())
  claimId          String
  claim            Claim     @relation(fields: [claimId], references: [id], onDelete: Restrict)
  position         Int
  date             String
  categoryCode     String
  category         Category  @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  amountCents      Int
  description      String
  limitCents       Int?
  justification    String?
  duplicateClaimId String?
  duplicateBasis   String?
  receipts         Receipt[]

  @@unique([claimId, position])
  @@unique([id, claimId])
  @@index([date, categoryCode, amountCents])
}

model Receipt {
  id           String    @id @default(uuid())
  lineId       String
  claimId      String
  line         ClaimLine @relation(fields: [lineId, claimId], references: [id, claimId], onDelete: Restrict)
  claim        Claim     @relation(fields: [claimId], references: [id], onDelete: Restrict)
  storageKey   String    @unique
  sha256       String
  sizeBytes    Int
  mime         String
  originalName String?
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt   DateTime

  @@index([sha256])
}

model ClaimEvent {
  id         String      @id @default(uuid())
  claimId    String
  claim      Claim       @relation(fields: [claimId], references: [id], onDelete: Restrict)
  seq        Int
  actorId    String
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     EventAction
  fromStatus ClaimStatus
  toStatus   ClaimStatus
  reason     String?
  at         DateTime

  @@unique([claimId, seq])
}

model Policy {
  id                    Int @id
  receiptThresholdCents Int
  secondApprovalCents   Int
}

enum NotificationKind {
  approved
  rejected
  sent_back
  paid
  digest
}

enum NotificationStatus {
  pending
  sent
  failed
  skipped
}

// No FK on userId/claimId (ADR-35); no address, subject or body is stored (ADR-53).
model Notification {
  id            String             @id @default(uuid())
  kind          NotificationKind
  userId        String
  claimId       String?
  eventSeq      Int?
  dedupeKey     String             @unique
  status        NotificationStatus @default(pending)
  attempts      Int                @default(0)
  createdAt     DateTime           @default(now())
  nextAttemptAt DateTime
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}
