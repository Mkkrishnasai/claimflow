{
  "name": "claimflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "test:unit": "vitest run",
    "test:e2e": "node --import tsx --test --test-concurrency=1 tests/e2e/*.test.ts",
    "start:api:test": "NODE_ENV=test DATABASE_URL=file:./test.db sh -c 'prisma migrate deploy 1>&2 && exec tsx api/src/server.ts'",
    "postinstall": "prisma generate",
    "seed": "node --import tsx prisma/seed.ts",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "build": "vite build --config web/vite.config.ts web"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "frontend"
  ]
}
